<div class="profile-picture">
    <img src="profile.jpg" alt="R-Mia M. Vidal">
</div>
.profile-picture {
    width: 180px;
    height: 180px;
    margin: 0 auto 25px;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid #f3a6c8;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
}

.profile-picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
